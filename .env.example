# Backend origin the landing page posts leads to. Leads go to STRV.AI, which owns
# the CRM they are worked in. Leave empty in local dev to use the Vite proxy
# (see vite.config.ts). In production: https://app.strv.ai
VITE_API_BASE_URL=

# Shared secret sent as X-Lead-Secret with each lead. Must match
# STRV_LEAD_INGEST_SECRET on the STRV.AI backend. It ships in the bundle, so it
# deters scripted submissions rather than authenticating anyone.
VITE_LEAD_INGEST_SECRET=
